# Copie para .env (nunca commitar). Valores de desenvolvimento local.
POSTGRES_USER=amma
POSTGRES_PASSWORD=amma_dev
POSTGRES_DB=amma
POSTGRES_PORT=5433
DATABASE_URL=postgresql://amma:amma_dev@localhost:5433/amma?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3000
# Segredo do JWT. Em desenvolvimento gere um com: openssl rand -hex 32
# Em produção use um valor único e secreto (nunca commitar).
JWT_SECRET=

# OTP simulado imprime o código no log e na resposta (só desenvolvimento).
OTP_MODE=simulated
# Onde os documentos enviados são gravados em desenvolvimento.
UPLOAD_DIR=./uploads

# Rotas e distâncias: "simulated" (padrão; recusado em produção) ou "mapbox".
ROUTE_PROVIDER=simulated
# Obrigatório quando ROUTE_PROVIDER=mapbox (token próprio; nunca commitar).
MAPBOX_ACCESS_TOKEN=
# Intervalo da rotina do despacho (expira ofertas, reenvia pedidos parados), em ms. 0 desliga.
DISPATCH_TICK_MS=3000

