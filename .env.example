# Copie para .env (nunca commitar). Valores de desenvolvimento local.
POSTGRES_USER=amma
POSTGRES_PASSWORD=amma_dev
POSTGRES_DB=amma
POSTGRES_PORT=5433
DATABASE_URL=postgresql://amma:amma_dev@localhost:5433/amma?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3000
# Segredo do JWT. Em desenvolvimento gere um com: openssl rand -hex 32
# Em produção use um valor único e secreto (nunca commitar).
JWT_SECRET=

# OTP simulado imprime o código no log e na resposta (só desenvolvimento).
OTP_MODE=simulated
# Onde os documentos enviados são gravados em desenvolvimento.
UPLOAD_DIR=./uploads

# Rotas e distâncias: "simulated" (padrão; recusado em produção) ou "mapbox".
ROUTE_PROVIDER=simulated
# Obrigatório quando ROUTE_PROVIDER=mapbox (token próprio; nunca commitar).
MAPBOX_ACCESS_TOKEN=
# Intervalo da rotina do despacho (expira ofertas, reenvia pedidos parados), em ms. 0 desliga.
DISPATCH_TICK_MS=3000


# Notificações push: "simulated" (padrão; recusado em produção) ou "expo".
PUSH_MODE=simulated
# Opcional com PUSH_MODE=expo: token de acesso do Expo (EAS) para "Enhanced Security".
EXPO_ACCESS_TOKEN=

# Pagamentos: "sandbox" (padrão; Pix e cartão simulados; recusado em produção). Não há provedor real ainda.
PAYMENT_PROVIDER=sandbox

# Endereço público da API, usado nos links de "compartilhar viagem" (o contato abre no navegador).
# Em produção, o endereço real com https.
PUBLIC_BASE_URL=http://localhost:3000

# Compra coletiva: parceiro regulado (consórcio/cooperativa). "sandbox" (padrão; simulado, sem dinheiro real; recusado em produção).
PURCHASE_PARTNER=sandbox
# Intervalo da rotina que fecha as votações vencidas da assembleia, em ms. 0 desliga.
ASSOCIATION_TICK_MS=30000

# Painel admin (apps/admin, Next.js): endereço da API visto pelo SERVIDOR do painel. O navegador nunca fala direto com a API.
ADMIN_API_URL=http://localhost:3000

# CORS: origens de navegador autorizadas a chamar a API, separadas por vírgula (ex.: https://amma.app).
# Vazio = nenhuma. O app nativo e o proxy do painel não precisam de CORS.
CORS_ORIGINS=
# Swagger em /docs. Padrão: ligado fora de produção, desligado em produção.
SWAGGER_ENABLED=

# Atrás de proxy/balanceador: nº de proxies confiáveis (ex.: 1), para o limite de taxa ver o IP real. Vazio = sem proxy.
TRUST_PROXY=
# Multiplica os limites de taxa (padrão 1). Só os testes de integração usam um valor alto.
RATE_LIMIT_SCALE=
# Em produção: JWT_SECRET com 32+ caracteres (openssl rand -hex 32), senão a API não sobe.
