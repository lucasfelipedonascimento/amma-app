// PostGIS é criado por SQL na migração 0_init (não por "extensions"), pois a imagem do
// Docker já traz extensões extras que o Prisma trataria como divergência e pediria reset.
// Dinheiro sempre em centavos (Int). Datas em UTC (timestamptz).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSAGEIRO
  MOTORISTA // cobre entregador e motorista
  COMERCIANTE
  ADMIN
}

enum VehicleType {
  MOTO
  CARRO
}

enum DocumentType {
  CNH
  DOCUMENTO_VEICULO
  FOTO
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  REPROVADO
}

enum ConsentType {
  POLITICA_PRIVACIDADE
}

enum RideType {
  RIDE
  DELIVERY
}

// Deve ficar idêntico a RIDE_STATUSES em packages/shared (há teste que confere).
enum RideStatus {
  REQUESTED
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

model User {
  id        String    @id @default(uuid())
  // E.164 (+55...). Vira null quando a conta é excluída (anonimização, LGPD).
  phone     String?   @unique
  name      String?
  // Uma pessoa pode ter mais de um perfil. ADMIN só é atribuído manualmente.
  roles     Role[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  // Exclusão de conta = anonimização; registros financeiros são mantidos sem identificação.
  deletedAt DateTime? @db.Timestamptz(3)

  quotaAccount  QuotaAccount?
  quotaEntries  QuotaEntry[]
  ridesAsClient Ride[]         @relation("RideClient")
  ridesAsWorker Ride[]         @relation("RideWorker")
  refreshTokens RefreshToken[]
  consents      Consent[]
  driverProfile DriverProfile?
  vehicles      Vehicle[]
  documents     Document[]     @relation("DocumentOwner")
  reviewedDocs  Document[]     @relation("DocumentReviewer")
}

// Código de uso único enviado por SMS. Só o hash é guardado.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

// Refresh token opaco, com rotação. Só o hash é guardado.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Consentimento LGPD: qual texto (versão) o usuário aceitou e quando.
model Consent {
  id         String      @id @default(uuid())
  userId     String
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @db.Timestamptz(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DriverProfile {
  userId    String   @id
  fullName  String
  cpf       String   @unique
  birthDate DateTime @db.Date
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id        String      @id @default(uuid())
  userId    String
  type      VehicleType
  plate     String
  model     String
  year      Int
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([userId, plate])
}

// Cada envio é um registro novo; vale o mais recente de cada tipo.
model Document {
  id              String         @id @default(uuid())
  userId          String
  vehicleId       String?
  type            DocumentType
  // Chave do arquivo no armazenamento (disco local em dev; bucket em produção).
  storageKey      String
  mimeType        String
  sizeBytes       Int
  status          ApprovalStatus @default(PENDENTE)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  user            User           @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reviewedBy      User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([userId, type])
  @@index([status])
}

model Ride {
  id       String     @id @default(uuid())
  type     RideType
  status   RideStatus @default(REQUESTED)
  clientId String
  workerId String?

  // Lat/lng simples por ora; colunas PostGIS entram junto com a busca por proximidade.
  pickupLat  Float
  pickupLng  Float
  dropoffLat Float
  dropoffLng Float

  distanceMeters  Int
  durationSeconds Int

  // Valores calculados por packages/shared (centavos). Congelados na conclusão.
  grossCents          Int
  platformFeeCents    Int @default(0)
  associationFeeCents Int @default(0)
  workerNetCents      Int @default(0)
  associationRate     Int @default(0) // 0, 2 ou 4

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  client       User         @relation("RideClient", fields: [clientId], references: [id])
  worker       User?        @relation("RideWorker", fields: [workerId], references: [id])
  quotaEntries QuotaEntry[]

  @@index([clientId])
  @@index([workerId])
  @@index([status])
}

// Saldo contábil de cotas (não é dinheiro em custódia).
model QuotaAccount {
  userId         String @id
  quotas         Int    @default(0)
  remainderCents Int    @default(0) // fração de cota (< 500)
  user           User   @relation(fields: [userId], references: [id])
}

// Extrato: cada taxa de associação que virou cotas.
model QuotaEntry {
  id          String   @id @default(uuid())
  userId      String
  rideId      String?
  feeCents    Int
  quotasAdded Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id])
  ride Ride? @relation(fields: [rideId], references: [id])

  @@index([userId])
}
