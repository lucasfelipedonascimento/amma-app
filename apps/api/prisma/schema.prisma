// PostGIS é criado por SQL na migração 0_init (não por "extensions"), pois a imagem do
// Docker já traz extensões extras que o Prisma trataria como divergência e pediria reset.
// Dinheiro sempre em centavos (Int). Datas em UTC (timestamptz).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSAGEIRO
  MOTORISTA // cobre entregador e motorista
  COMERCIANTE
  ADMIN
}

enum VehicleType {
  MOTO
  CARRO
}

enum DocumentType {
  CNH
  DOCUMENTO_VEICULO
  FOTO
  // Etapa 7: só exigidos se as regras municipais de corrida de passageiro pedirem.
  ANTECEDENTES
  LICENCA_MUNICIPAL
  SEGURO_PASSAGEIROS
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  REPROVADO
}

enum ConsentType {
  POLITICA_PRIVACIDADE
  // Motorista autoriza usar a localização (inclusive com o app em segundo plano) enquanto está online.
  LOCALIZACAO_SEGUNDO_PLANO
}

enum RideType {
  RIDE
  DELIVERY
}

// Deve ficar idêntico a RIDE_STATUSES em packages/shared (há teste que confere).
enum RideStatus {
  REQUESTED
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

// Pedido de entrega. Deve ficar idêntico a DELIVERY_STATUSES em packages/shared (há teste que confere).
enum DeliveryStatus {
  CRIADO
  OFERECIDO
  ACEITO
  A_CAMINHO_COLETA
  COLETADO
  A_CAMINHO_ENTREGA
  ENTREGUE
  CANCELADO
}

enum CancelReason {
  CLIENTE_DESISTIU
  SEM_MOTORISTA
  COLETA_IMPOSSIVEL
  ENTREGA_IMPOSSIVEL
  ADMIN_CANCELOU
  PAGAMENTO_NAO_CONFIRMADO
}

enum OfferStatus {
  PENDENTE
  ACEITA
  RECUSADA
  EXPIRADA
  CANCELADA // pedido cancelado/liberado enquanto a oferta estava pendente
}

enum DeliveryEventType {
  STATUS // mudança de estado do pedido
  OFERTA // oferta enviada a um motorista
  ACEITE
  RECUSA
  EXPIRACAO
  DESISTENCIA // motorista liberou o pedido depois de aceitar
  SEM_CANDIDATOS
}

enum PaymentMethod {
  PIX
  CARTAO
}

// Deve ficar idêntico a PAYMENT_STATUSES em packages/shared (há teste que confere).
enum PaymentStatus {
  PENDENTE
  PAGO
  EXPIRADO
  ESTORNADO
}

// Etapa 7: o mesmo pedido (Delivery) serve a entregas e a corridas de passageiro.
// Deve ficar idêntico a DELIVERY_KINDS em packages/shared (há teste que confere).
enum DeliveryKind {
  ENTREGA
  CORRIDA
}

enum Gender {
  FEMININO
  MASCULINO
  NAO_INFORMADO
}

// Deve ficar idêntico a RATING_DIRECTIONS em packages/shared.
enum RatingDirection {
  CLIENTE_AVALIA_MOTORISTA
  MOTORISTA_AVALIA_CLIENTE
}

// Deve ficar idêntico a REPORT_CATEGORIES / REPORT_STATUSES / EMERGENCY_STATUSES em packages/shared.
enum ReportCategory {
  ASSEDIO
  VIOLENCIA
  DISCRIMINACAO
  DIRECAO_PERIGOSA
  MOTORISTA_DIFERENTE
  VEICULO_DIFERENTE
  COBRANCA_INDEVIDA
  OUTRO
}

enum ReportStatus {
  ABERTA
  EM_ANALISE
  PROCEDENTE
  IMPROCEDENTE
  ARQUIVADA
}

enum EmergencyStatus {
  ABERTO
  EM_ATENDIMENTO
  ENCERRADO
}

enum LedgerKind {
  RIDE_SETTLEMENT
  REVERSAL
  GROUP_CONTRIBUTION // Etapa 8: aporte de compra coletiva (registro; o dinheiro vai ao parceiro)
  SURPLUS_DISTRIBUTION // Etapa 8: fechamento das sobras anuais
  HOST_BENEFIT // Etapa 9: benefício ao anfitrião de ponto de acolhida
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model User {
  id        String    @id @default(uuid())
  // E.164 (+55...). Vira null quando a conta é excluída (anonimização, LGPD).
  phone     String?   @unique
  name      String?
  // Uma pessoa pode ter mais de um perfil. ADMIN só é atribuído manualmente.
  roles     Role[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  // Exclusão de conta = anonimização; registros financeiros são mantidos sem identificação.
  deletedAt DateTime? @db.Timestamptz(3)

  quotaAccount  QuotaAccount?
  quotaEntries  QuotaEntry[]
  ridesAsClient Ride[]         @relation("RideClient")
  ridesAsWorker Ride[]         @relation("RideWorker")
  refreshTokens RefreshToken[]
  consents      Consent[]
  driverProfile DriverProfile?
  vehicles      Vehicle[]
  documents     Document[]     @relation("DocumentOwner")
  reviewedDocs  Document[]     @relation("DocumentReviewer")

  presence           DriverPresence?
  deliveriesAsClient Delivery[]        @relation("DeliveryClient")
  deliveriesAsWorker Delivery[]        @relation("DeliveryWorker")
  deliveryOffers     DeliveryOffer[]
  pushTokens         PushToken[]
  merchant           Merchant?
  ratingsGiven       Rating[]          @relation("RatingAuthor")
  messagesSent       DeliveryMessage[]
  ratingsReceived    Rating[]          @relation("RatingRatee")
  emergencyAlerts    EmergencyAlert[]
  reportsMade        Report[]          @relation("ReportReporter")
  reportsReceived    Report[]          @relation("ReportReported")

  // Etapa 8: associação
  proposalsCreated Proposal[]
  votes            Vote[]
  voteRecords      VoteRecord[]
  queueEntries     QueueEntry[]
  contributions    Contribution[]
  insuranceClaims  InsuranceClaim[] @relation("ClaimClaimant")
  surplusShares    SurplusShare[]

  // Etapa 9: pontos de acolhida
  welcomePoints WelcomePoint[] @relation("PointOwner")
  checkIns      CheckIn[]
  pointRatings  PointRating[]  @relation("PointRatingAuthor")
  pointReports  PointReport[]  @relation("PointReporter")

  // Etapa 10: painel admin. blockedAt é cópia do bloqueio em vigor (a verdade está em AccountBlock).
  blockedAt     DateTime?      @db.Timestamptz(3)
  blocks        AccountBlock[] @relation("BlockTarget")
  blocksMade    AccountBlock[] @relation("BlockAuthor")
  auditLogs     AuditLog[]
  budgetEntries BudgetEntry[]
}

// Código de uso único enviado por SMS. Só o hash é guardado.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

// Refresh token opaco, com rotação. Só o hash é guardado.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Consentimento LGPD: qual texto (versão) o usuário aceitou e quando.
model Consent {
  id         String      @id @default(uuid())
  userId     String
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @db.Timestamptz(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DriverProfile {
  userId             String    @id
  fullName           String
  cpf                String    @unique
  birthDate          DateTime  @db.Date
  // Taxa de associação escolhida pelo motorista (0, 2 ou 4); vira cotas no ledger.
  associationRate    Int       @default(0)
  // Etapa 7: autodeclarado pelo motorista; só vale para a opção "motorista mulher" depois que o
  // admin confere (genderVerifiedAt). Mudar o gênero zera a verificação.
  gender             Gender?
  genderVerifiedAt   DateTime? @db.Timestamptz(3)
  genderVerifiedById String?
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id        String      @id @default(uuid())
  userId    String
  type      VehicleType
  plate     String
  model     String
  year      Int
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  rides     Delivery[]

  @@unique([userId, plate])
}

// Cada envio é um registro novo; vale o mais recente de cada tipo.
model Document {
  id              String         @id @default(uuid())
  userId          String
  vehicleId       String?
  type            DocumentType
  // Chave do arquivo no armazenamento (disco local em dev; bucket em produção).
  storageKey      String
  mimeType        String
  sizeBytes       Int
  status          ApprovalStatus @default(PENDENTE)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  user            User           @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reviewedBy      User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  verification    DocumentVerification?

  @@index([userId, type])
  @@index([status])
}

enum VerificationStatus {
  CONCLUIDA
  // Leitor fora do ar ou arquivo ilegível: o documento segue para análise manual normalmente.
  INDISPONIVEL
}

// Resultado da leitura automática (serviço Python) de CNH e CRLV. É só uma recomendação para o painel,
// salvo DOC_AUTO_APPROVE. LGPD: guarda campos MASCARADOS (CPF/RENAVAM/registro parciais), nunca o texto lido.
model DocumentVerification {
  documentId     String             @id
  status         VerificationStatus
  // APROVAR | REVISAR (null quando INDISPONIVEL)
  recommendation String?
  findings       Json
  extracted      Json
  engine         String?
  autoApproved   Boolean            @default(false)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  document       Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Ride {
  id       String     @id @default(uuid())
  type     RideType
  status   RideStatus @default(REQUESTED)
  clientId String
  workerId String?

  // Lat/lng simples por ora; colunas PostGIS entram junto com a busca por proximidade.
  pickupLat  Float
  pickupLng  Float
  dropoffLat Float
  dropoffLng Float

  distanceMeters  Int
  durationSeconds Int

  // Valores calculados por packages/shared (centavos). Congelados na conclusão.
  grossCents          Int
  platformFeeCents    Int @default(0)
  associationFeeCents Int @default(0)
  workerNetCents      Int @default(0)
  associationRate     Int @default(0) // 0, 2 ou 4

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  client       User         @relation("RideClient", fields: [clientId], references: [id])
  worker       User?        @relation("RideWorker", fields: [workerId], references: [id])
  quotaEntries QuotaEntry[]

  @@index([clientId])
  @@index([workerId])
  @@index([status])
}

// Saldo contábil de cotas (não é dinheiro em custódia).
model QuotaAccount {
  userId         String @id
  quotas         Int    @default(0)
  remainderCents Int    @default(0) // fração de cota (< 500)
  user           User   @relation(fields: [userId], references: [id])
}

// Extrato: cada taxa de associação que virou cotas.
model QuotaEntry {
  id          String   @id @default(uuid())
  userId      String
  rideId      String?
  feeCents    Int
  quotasAdded Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id])
  ride Ride? @relation(fields: [rideId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Etapa 4: entregas, despacho, presença e ledger persistido
// ---------------------------------------------------------------------------

// Presença do motorista: online/offline e ÚLTIMA posição (PostGIS). Sem histórico de trajeto (LGPD).
// A posição "quente" vive no Redis; aqui ela é gravada com limite de frequência.
// "location" só é lida/escrita por SQL cru (Prisma não tem tipo geography); índice GiST na migração.
model DriverPresence {
  userId      String                                @id
  online      Boolean                               @default(false)
  onlineSince DateTime?                             @db.Timestamptz(3)
  location    Unsupported("geography(Point,4326)")?
  locationAt  DateTime?                             @db.Timestamptz(3)
  updatedAt   DateTime                              @updatedAt @db.Timestamptz(3)
  user        User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location], type: Gist, map: "DriverPresence_location_gist")
  @@index([online])
}

// Pedido de entrega. Valores em centavos; distância em metros; tempo em segundos.
model Delivery {
  id       String         @id @default(uuid())
  // Etapa 7: CORRIDA = passageiro. coleta = embarque, entrega = destino. Mesma máquina de estados.
  kind     DeliveryKind   @default(ENTREGA)
  status   DeliveryStatus @default(CRIADO)
  clientId String
  workerId String?

  // Só corrida: tipo de veículo pedido, preferência por motorista mulher e veículo que atendeu.
  vehicleType         VehicleType?
  womenDriverOnly     Boolean      @default(false)
  vehicleId           String?
  // PIN de 4 dígitos: o passageiro informa ao motorista para confirmar o embarque. Nunca vai ao motorista.
  boardingPin         String?
  boardingPinAttempts Int          @default(0)

  pickupLat      Float
  pickupLng      Float
  pickupAddress  String
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String
  notes          String?
  // Chave enviada pelo app a cada tentativa de pedir: repetir (duplo toque) devolve o mesmo pedido.
  idempotencyKey String?

  // Cotação feita na criação (rota do provedor + tabela de preço vigente).
  distanceMeters  Int
  durationSeconds Int
  fareCents       Int
  pricingVersion  String
  minimumApplied  Boolean

  // Preenchidos ao concluir (ENTREGUE) e nunca mais alterados.
  platformFeeCents    Int?
  associationFeeCents Int?
  workerNetCents      Int?
  associationRate     Int?

  cancelReason CancelReason?
  cancelNote   String?
  cancelledAt  DateTime?     @db.Timestamptz(3)

  // A janela de busca por motorista conta a partir de createdAt.
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  pickedUpAt  DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  client          User              @relation("DeliveryClient", fields: [clientId], references: [id])
  worker          User?             @relation("DeliveryWorker", fields: [workerId], references: [id])
  offers          DeliveryOffer[]
  events          DeliveryEvent[]
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id])
  payment         Payment?
  ratings         Rating[]
  shares          TripShare[]
  tripPoints      TripPoint[]
  emergencyAlerts EmergencyAlert[]
  reports         Report[]
  messages        DeliveryMessage[]

  @@unique([clientId, idempotencyKey])
  @@index([clientId, createdAt])
  @@index([workerId, status])
  @@index([status])
  @@index([kind, clientId, createdAt])
}

// Uma oferta a um motorista. Um pedido tem no máximo uma oferta PENDENTE por vez.
model DeliveryOffer {
  id                String      @id @default(uuid())
  deliveryId        String
  driverId          String
  status            OfferStatus @default(PENDENTE)
  // Distância em linha reta (usada no ranking) e estimativa de rota até a coleta (informativa).
  distanceMeters    Int
  pickupEtaSeconds  Int?
  pickupRouteMeters Int?
  expiresAt         DateTime    @db.Timestamptz(3)
  respondedAt       DateTime?   @db.Timestamptz(3)
  declineReason     String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  delivery          Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driver            User        @relation(fields: [driverId], references: [id])

  @@index([deliveryId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
}

// Linha do tempo e registro de decisões do despacho (somente inserção).
// `reason` usa os códigos de DISPATCH_REASONS / CANCEL_REASONS do shared.
// Chat da corrida/entrega entre cliente e motorista. Só durante o atendimento; some junto com o pedido
// e as mensagens de quem exclui a conta são apagadas (LGPD).
model DeliveryMessage {
  id         String   @id @default(uuid())
  deliveryId String
  senderId   String
  body       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])

  @@index([deliveryId, createdAt])
  @@index([senderId])
}

model DeliveryEvent {
  id         String            @id @default(uuid())
  deliveryId String
  type       DeliveryEventType
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus?
  actorId    String?
  reason     String?
  data       Json?
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  delivery   Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
}

// Livro-razão em partidas dobradas (ver docs/REGRAS_FINANCEIRAS.md). SOMENTE INSERÇÃO:
// um gatilho no banco (migração) rejeita UPDATE e DELETE. Estorno = nova transação.
model LedgerTransaction {
  id         String          @id @default(uuid())
  kind       LedgerKind
  // Id do pedido. (kind, reference) único => fechar o mesmo pedido duas vezes é impossível.
  reference  String
  reversalOf String?         @unique
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  postings   LedgerPosting[]

  @@unique([kind, reference])
}

model LedgerPosting {
  id            String            @id @default(uuid())
  transactionId String
  account       String
  direction     LedgerDirection
  amountCents   Int
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])

  @@index([account])
  @@index([transactionId])
}

// Tabela de preço versionada (PricingConfig do shared). Versões nunca são editadas.
model PricingConfigVersion {
  version          String   @id
  // ENTREGA, CORRIDA_CARRO ou CORRIDA_MOTO (PRICING_PROFILES do shared). Cada perfil tem a sua linha do tempo.
  profile          String   @default("ENTREGA")
  effectiveFrom    DateTime @db.Timestamptz(3)
  baseCents        Int
  perKmCents       Int
  perMinuteCents   Int
  minimumFareCents Int
  createdById      String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([profile, effectiveFrom])
}

// Parâmetros do despacho (linha única, id = 1). Sem linha => padrões do shared.
model DispatchSettings {
  id                    Int      @id @default(1)
  radiusMeters          Int
  offerTtlSeconds       Int
  maxSearchSeconds      Int
  maxPositionAgeSeconds Int
  updatedById           String?
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
}

// Endereço de notificação push (Expo) de um aparelho. Um token pertence a um só usuário por vez:
// se outra pessoa entra no mesmo aparelho, o token muda de dono. Apagado no logout e na exclusão da conta.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Etapa 6: pagamento, comerciante e avaliação
// ---------------------------------------------------------------------------

// Pagamento do pedido (um por pedido). O dinheiro fica com o parceiro regulado; aqui só o estado.
// Nunca guarda número de cartão: só bandeira e 4 últimos dígitos, para o recibo.
model Payment {
  id             String        @id @default(uuid())
  deliveryId     String        @unique
  method         PaymentMethod
  status         PaymentStatus @default(PENDENTE)
  amountCents    Int
  // Qual provedor processou ("sandbox" em desenvolvimento) e o identificador dele para esta cobrança.
  provider       String
  providerRef    String        @unique
  // Pix: código "copia e cola" e prazo para pagar.
  pixCode        String?
  pixExpiresAt   DateTime?     @db.Timestamptz(3)
  cardBrand      String?
  cardLast4      String?
  paidAt         DateTime?     @db.Timestamptz(3)
  refundedAt     DateTime?     @db.Timestamptz(3)
  refundRef      String?
  refundReason   String?
  // Repasse (split): feito no provedor depois da entrega concluída, quando o motorista e as taxas são conhecidos.
  splitSettledAt DateTime?     @db.Timestamptz(3)
  splitRef       String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  delivery       Delivery      @relation(fields: [deliveryId], references: [id])

  @@index([status, pixExpiresAt])
}

// Avisos (webhooks) já processados, por provedor. Receber o mesmo aviso duas vezes não repete efeito.
model PaymentWebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String
  type       String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
}

// Estabelecimento do comerciante. O endereço é o ponto de coleta padrão dos pedidos dele.
model Merchant {
  userId          String         @id
  tradeName       String
  // CNPJ só com dígitos; opcional (MEI/informal pode cadastrar sem).
  cnpj            String?        @unique
  address         String
  lat             Float
  lng             Float
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  // Etapa 10: cadastro revisado pelo admin. Recusa exige motivo.
  approvalStatus  ApprovalStatus @default(PENDENTE)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?      @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Avaliação depois de entregue (1 a 5; o banco confere). Uma por direção em cada pedido:
// o cliente avalia o motorista e, nas corridas, o motorista avalia o passageiro (avaliação mútua).
model Rating {
  id         String          @id @default(uuid())
  deliveryId String
  direction  RatingDirection @default(CLIENTE_AVALIA_MOTORISTA)
  authorId   String
  // Quem recebeu a nota.
  rateeId    String
  stars      Int
  comment    String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  delivery   Delivery        @relation(fields: [deliveryId], references: [id])
  author     User            @relation("RatingAuthor", fields: [authorId], references: [id])
  ratee      User            @relation("RatingRatee", fields: [rateeId], references: [id])

  @@unique([deliveryId, direction])
  @@index([rateeId])
}

// ---------------------------------------------------------------------------
// Etapa 7: corridas de passageiro — segurança e regras municipais
// ---------------------------------------------------------------------------

// Link de acompanhamento da viagem para um contato de confiança. Só o hash do token é guardado.
// O contato não precisa de conta nem de telefone cadastrado: recebe o link pelo compartilhamento do sistema.
model TripShare {
  id           String    @id @default(uuid())
  deliveryId   String
  tokenHash    String    @unique
  contactLabel String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

// Botão de emergência. Fica registrado mesmo se a conta for excluída (segurança), sem identificação.
model EmergencyAlert {
  id          String          @id @default(uuid())
  userId      String
  deliveryId  String?
  // Quem apertou: PASSAGEIRO ou MOTORISTA (papel naquela corrida).
  actorRole   String
  lat         Float?
  lng         Float?
  note        String?
  status      EmergencyStatus @default(ABERTO)
  handledById String?
  handledNote String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id])
  delivery    Delivery?       @relation(fields: [deliveryId], references: [id])

  @@index([status, createdAt])
  @@index([deliveryId])
}

// Canal de denúncia. O denunciado é sempre a outra parte da corrida (o app não aceita um id qualquer).
model Report {
  id          String         @id @default(uuid())
  reporterId  String
  reportedId  String?
  deliveryId  String?
  category    ReportCategory
  description String
  status      ReportStatus   @default(ABERTA)
  handledById String?
  // Resposta da associação, visível a quem denunciou.
  resolution  String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  reporter    User           @relation("ReportReporter", fields: [reporterId], references: [id])
  reported    User?          @relation("ReportReported", fields: [reportedId], references: [id])
  delivery    Delivery?      @relation(fields: [deliveryId], references: [id])

  @@index([status, createdAt])
  @@index([deliveryId])
  @@index([reportedId])
}

// Registro da viagem: posição do veículo durante a corrida. Apagado após TRIP_RECORD_RETENTION_DAYS,
// exceto de corridas com denúncia ou alerta de emergência.
model TripPoint {
  id         String   @id @default(uuid())
  deliveryId String
  lat        Float
  lng        Float
  at         DateTime @default(now()) @db.Timestamptz(3)
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, at])
  @@index([at])
}

// Quem da associação abriu o registro de uma viagem (auditoria de acesso a dado sensível).
model TripRecordAccess {
  id         String   @id @default(uuid())
  deliveryId String
  adminId    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([deliveryId])
}

// Regras municipais de corrida de passageiro (JSON validado por validateMunicipalRules). Versões nunca
// são editadas; a vigente é a mais recente com effectiveFrom <= agora. Sem linha => padrão NÃO confirmado.
model MunicipalRulesVersion {
  version        String   @id
  effectiveFrom  DateTime @db.Timestamptz(3)
  rules          Json
  // Fonte legal informada pelo admin (ex.: "Decreto X/2026, art. Y").
  legalReference String?
  createdById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([effectiveFrom])
}

// ---------------------------------------------------------------------------
// Etapa 8: associação (assembleia, compra coletiva, seguro mútuo, sobras)
// Sócio = quem tem ao menos 1 cota no ledger. Registros abaixo marcados "somente inserção" têm
// gatilho no banco que recusa UPDATE/DELETE (ver a migração associacao).
// ---------------------------------------------------------------------------

// Deve ficar idêntico a PROPOSAL_KINDS / PROPOSAL_STATUSES / VOTE_CHOICES / CLAIM_KINDS / CLAIM_STATUSES no shared.
enum ProposalKind {
  GERAL
  REGRA_COMPRA_COLETIVA
}

enum ProposalStatus {
  ABERTA
  APROVADA
  REJEITADA
  SEM_QUORUM
}

enum VoteChoice {
  SIM
  NAO
  ABSTENCAO
}

enum VoteAction {
  VOTOU
  MUDOU
}

enum GroupStatus {
  ABERTO
  ENCERRADO
}

enum QueueEntryStatus {
  NA_FILA
  CONTEMPLADO
  DESISTIU
}

enum ContributionStatus {
  // Registrado no parceiro, ainda sem confirmação (o sócio paga ao parceiro e ele avisa depois).
  PENDENTE
  CONFIRMADO
  RECUSADO
}

enum ClaimKind {
  ACIDENTE
  ROUBO_FURTO
  DANOS_VEICULO
  OUTRO
}

enum ClaimStatus {
  ENVIADA
  EM_ANALISE
  APROVADA
  NEGADA
  CANCELADA
}

// Proposta da assembleia. Depois de fechada (status != ABERTA) nada mais muda: o banco recusa.
model Proposal {
  id            String         @id @default(uuid())
  kind          ProposalKind
  title         String
  description   String
  // Só REGRA_COMPRA_COLETIVA: a alteração proposta, ex. {"minQuotas": 5}. Aplicada se aprovada.
  ruleChange    Json?
  quorumPercent Int            @default(0)
  // Quantos sócios podiam votar quando a proposta abriu (base do quórum).
  eligibleCount Int
  opensAt       DateTime       @db.Timestamptz(3)
  closesAt      DateTime       @db.Timestamptz(3)
  status        ProposalStatus @default(ABERTA)
  createdById   String
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  // Resultado, gravado uma única vez no fechamento.
  closedAt            DateTime? @db.Timestamptz(3)
  yesCount            Int?
  noCount             Int?
  abstainCount        Int?
  // SHA-256 dos votos (sócio + escolha) em ordem fixa: prova de que o resultado bate com a apuração.
  ballotDigest        String?
  appliedRulesVersion String?

  createdBy User         @relation(fields: [createdById], references: [id])
  votes     Vote[]
  records   VoteRecord[]

  @@index([status, closesAt])
}

// Voto atual de um sócio (1 por proposta). Pode ser trocado até o fechamento; depois o banco recusa.
model Vote {
  id         String     @id @default(uuid())
  proposalId String
  voterId    String
  choice     VoteChoice
  castAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @db.Timestamptz(3)

  proposal Proposal @relation(fields: [proposalId], references: [id])
  voter    User     @relation(fields: [voterId], references: [id])

  @@unique([proposalId, voterId])
}

// Histórico imutável de votos (somente inserção): cada voto e cada mudança, em ordem.
model VoteRecord {
  id         String     @id @default(uuid())
  proposalId String
  voterId    String
  choice     VoteChoice
  action     VoteAction
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  proposal Proposal @relation(fields: [proposalId], references: [id])
  voter    User     @relation(fields: [voterId], references: [id])

  @@index([proposalId, createdAt])
  @@index([voterId])
}

// Regras da compra coletiva em vigor. Versões nunca são editadas (somente inserção): mudar = nova versão,
// que só nasce de proposta aprovada na assembleia. Sem versão vale DEFAULT_PURCHASE_RULES.
model PurchaseRulesVersion {
  id            String   @id @default(uuid())
  rules         Json
  proposalId    String?  @unique
  effectiveFrom DateTime @default(now()) @db.Timestamptz(3)

  @@index([effectiveFrom])
}

// Grupo de compra coletiva de veículos (uma fila por grupo).
model PurchaseGroup {
  id          String      @id @default(uuid())
  name        String
  description String?
  vehicleType VehicleType
  // Preço de UM veículo; a cada múltiplo aportado o grupo pode contemplar mais um sócio.
  targetCents Int
  status      GroupStatus @default(ABERTO)
  createdById String
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  entries       QueueEntry[]
  contributions Contribution[]
  awards        GroupAward[]
}

model QueueEntry {
  id       String           @id @default(uuid())
  groupId  String
  userId   String
  status   QueueEntryStatus @default(NA_FILA)
  // Quando entrou (de novo, se saiu e voltou): é daqui que conta o tempo de fila.
  joinedAt DateTime         @default(now()) @db.Timestamptz(3)
  leftAt   DateTime?        @db.Timestamptz(3)

  group PurchaseGroup @relation(fields: [groupId], references: [id])
  user  User          @relation(fields: [userId], references: [id])
  award GroupAward?

  @@unique([groupId, userId])
  @@index([groupId, status])
}

// Aporte do sócio ao grupo. O dinheiro vai ao parceiro regulado; aqui fica o registro e o ledger.
model Contribution {
  id             String             @id @default(uuid())
  groupId        String
  userId         String
  amountCents    Int
  status         ContributionStatus
  partner        String
  partnerRef     String?
  declineReason  String?
  // Como o sócio paga ao parceiro (link, código Pix, linha do boleto): só enquanto PENDENTE.
  instructions   String?
  idempotencyKey String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  confirmedAt    DateTime?          @db.Timestamptz(3)

  group PurchaseGroup @relation(fields: [groupId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@unique([partner, partnerRef])
  @@index([groupId, status])
  @@index([status, createdAt])
}

// Avisos (webhooks) do parceiro financeiro já processados. Receber o mesmo aviso duas vezes não repete efeito.
model PartnerWebhookEvent {
  id         String   @id @default(uuid())
  partner    String
  eventId    String
  type       String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([partner, eventId])
}

// Contemplação registrada pela associação (somente inserção).
model GroupAward {
  id          String   @id @default(uuid())
  groupId     String
  entryId     String   @unique
  userId      String
  position    Int
  score       Int
  fundedCents Int
  awardedById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  group PurchaseGroup @relation(fields: [groupId], references: [id])
  entry QueueEntry    @relation(fields: [entryId], references: [id])

  @@index([groupId])
}

// Pedido de seguro mútuo. A decisão é humana (decidedById, nunca o próprio sócio).
model InsuranceClaim {
  id             String      @id @default(uuid())
  claimantId     String
  kind           ClaimKind
  occurredAt     DateTime    @db.Timestamptz(3)
  description    String
  requestedCents Int
  status         ClaimStatus @default(ENVIADA)
  decidedById    String?
  decidedAt      DateTime?   @db.Timestamptz(3)
  decisionNote   String?
  approvedCents  Int?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  claimant    User                  @relation("ClaimClaimant", fields: [claimantId], references: [id])
  attachments InsuranceAttachment[]
  events      InsuranceEvent[]

  @@index([claimantId, createdAt])
  @@index([status, createdAt])
}

model InsuranceAttachment {
  id         String   @id @default(uuid())
  claimId    String
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  claim InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// Linha do tempo do pedido (somente inserção): o que o sócio vê no acompanhamento.
model InsuranceEvent {
  id         String       @id @default(uuid())
  claimId    String
  actorId    String
  fromStatus ClaimStatus?
  toStatus   ClaimStatus
  note       String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  claim InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
}

// Fechamento de sobras de um ano (um por ano; somente inserção).
model SurplusRun {
  id                 String   @id @default(uuid())
  year               Int      @unique
  distributableCents Int
  useWeightPercent   Int
  totalUseCents      Int
  totalQuotas        Int
  memberCount        Int
  // Resumo da simulação aprovada; o fechamento só vale se os dados não mudaram desde a simulação.
  checksum           String
  closedById         String
  closedAt           DateTime @default(now()) @db.Timestamptz(3)

  shares SurplusShare[]
}

model SurplusShare {
  id          String @id @default(uuid())
  runId       String
  userId      String
  quotas      Int
  useCents    Int
  amountCents Int

  run  SurplusRun @relation(fields: [runId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([runId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Etapa 9: pontos de acolhida
// ---------------------------------------------------------------------------

enum PointType {
  ESPACO_PUBLICO
  CASA_PARCEIRA
  COMERCIO
}

enum PointStatus {
  EM_ANALISE
  ATIVO
  SUSPENSO
  RECUSADO
  REMOVIDO
}

enum Amenity {
  AGUA
  BANHEIRO
  CARREGADOR
  DESCANSO
  WIFI
  ALIMENTACAO
  ESTACIONAMENTO
}

enum HostBenefitKind {
  CREDITO
  DESCONTO
}

enum PointRatingDirection {
  VISITANTE_AVALIA_PONTO
  ANFITRIAO_AVALIA_VISITANTE
}

enum PointReportCategory {
  SEGURANCA
  ASSEDIO
  COBRANCA_INDEVIDA
  LOCAL_INEXISTENTE
  ESTRUTURA_DIFERENTE
  OUTRO
}

enum PointReportStatus {
  ABERTA
  PROCEDENTE
  IMPROCEDENTE
}

model WelcomePoint {
  id           String          @id @default(uuid())
  // Quem cadastrou. Nos pontos com anfitrião (casa, comércio) é o anfitrião.
  ownerId      String
  type         PointType
  status       PointStatus
  name         String
  description  String?
  // Endereço completo: o mapa só mostra o bairro e uma posição aproximada nas casas.
  address      String
  neighborhood String
  reference    String?
  lat          Float
  lng          Float
  // OpeningHours do shared ({ always, slots }), validado na API.
  hours        Json
  amenities    Amenity[]
  capacity     Int
  benefitKind  HostBenefitKind @default(CREDITO)
  // Só casa parceira: checklist de segurança confirmado pelo anfitrião.
  checklist    Json?
  // Motivo do status atual (suspensão automática, recusa, remoção).
  statusNote   String?
  decidedById  String?
  decidedAt    DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  owner    User                @relation("PointOwner", fields: [ownerId], references: [id])
  photos   WelcomePointPhoto[]
  checkIns CheckIn[]
  reports  PointReport[]
  events   PointEvent[]

  @@index([status, lat, lng])
  @@index([ownerId])
}

model WelcomePointPhoto {
  id         String   @id @default(uuid())
  pointId    String
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  point WelcomePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

model CheckIn {
  id             String    @id @default(uuid())
  pointId        String
  userId         String
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  // true = a visita contou (ficou o mínimo e encerrou sozinho o visitante).
  completed      Boolean   @default(false)
  // Distância do aparelho ao ponto no momento do check-in. A posição em si não é guardada.
  distanceMeters Int
  benefitCents   Int       @default(0)

  point   WelcomePoint  @relation(fields: [pointId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  ratings PointRating[]

  @@index([pointId, startedAt])
  @@index([userId, startedAt])
}

model PointRating {
  id        String               @id @default(uuid())
  checkInId String
  direction PointRatingDirection
  authorId  String
  stars     Int
  comment   String?
  createdAt DateTime             @default(now()) @db.Timestamptz(3)

  checkIn CheckIn @relation(fields: [checkInId], references: [id])
  author  User    @relation("PointRatingAuthor", fields: [authorId], references: [id])

  @@unique([checkInId, direction])
  @@index([authorId])
}

model PointReport {
  id           String              @id @default(uuid())
  pointId      String
  reporterId   String
  category     PointReportCategory
  text         String?
  status       PointReportStatus   @default(ABERTA)
  resolvedById String?
  resolvedAt   DateTime?           @db.Timestamptz(3)
  response     String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  point    WelcomePoint @relation(fields: [pointId], references: [id])
  reporter User         @relation("PointReporter", fields: [reporterId], references: [id])

  @@index([pointId, status])
  @@index([status, createdAt])
}

// Linha do tempo do ponto (somente inserção): cadastro, aprovação, suspensão, remoção.
model PointEvent {
  id         String       @id @default(uuid())
  pointId    String
  // null = o sistema (suspensão automática).
  actorId    String?
  fromStatus PointStatus?
  toStatus   PointStatus
  note       String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  point WelcomePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId, createdAt])
}

// ---------------------------------------------------------------------------
// Etapa 10: painel admin — bloqueios com recurso, trilha de auditoria e orçamento aberto
// ---------------------------------------------------------------------------

enum BlockStatus {
  ATIVO
  EM_RECURSO
  MANTIDO
  REVOGADO
}

enum BudgetKind {
  RECEITA
  DESPESA
}

// Bloqueio de conta. Motivo, autor e data nunca mudam (trigger); só o andamento do recurso/revogação.
// Só um bloqueio em vigor (status <> REVOGADO) por pessoa (índice único parcial na migração).
model AccountBlock {
  id             String      @id @default(uuid())
  userId         String
  reason         String
  status         BlockStatus @default(ATIVO)
  blockedById    String
  blockedAt      DateTime    @default(now()) @db.Timestamptz(3)
  // Recurso (um por bloqueio).
  appealText     String?
  appealedAt     DateTime?   @db.Timestamptz(3)
  decidedById    String?
  decidedAt      DateTime?   @db.Timestamptz(3)
  decisionReason String?
  // Revogação direta pelo admin (sem passar por recurso).
  revokedById    String?
  revokedAt      DateTime?   @db.Timestamptz(3)
  revokeReason   String?

  user      User @relation("BlockTarget", fields: [userId], references: [id])
  blockedBy User @relation("BlockAuthor", fields: [blockedById], references: [id])

  @@index([userId, status])
  @@index([status, blockedAt])
}

// Trilha de auditoria (somente inserção): quem fez o quê, em qual registro e quando.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  // "POST /admin/users/:id/block"; texto em português em shared/audit.ts.
  action    String
  // Parâmetros da rota (ids dos registros afetados). Sem corpo da requisição: pode ter dado pessoal.
  params    Json
  // Motivo informado na ação (quando houver).
  reason    String?
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// Lançamentos manuais do orçamento aberto (somente inserção; erro = estorno). As taxas vêm do ledger.
model BudgetEntry {
  id          String     @id @default(uuid())
  kind        BudgetKind
  category    String
  description String
  amountCents Int
  occurredOn  DateTime   @db.Date
  // Número do comprovante/nota (texto livre; o arquivo não é guardado aqui).
  receiptRef  String?
  createdById String
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  // Estorno: lançamento que cancela outro. Um estorno por lançamento.
  reversalOf  String?    @unique

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([occurredOn])
}
