{
  "name": "@amma/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:int": "vitest run --config vitest.int.config.mts"
  },
  "dependencies": {
    "@amma/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-ws": "^11",
    "@nestjs/websockets": "^11",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "ioredis": "^5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@swc/core": "^1.16.20",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/ws": "^8",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
  }
}
