{
  "name": "@amma/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "build": "echo \"mobile: build via EAS (etapa futura)\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@amma/shared": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "^58.0.21",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "*",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-maps|@amma/.*))"
    ]
  }
}
